{
  "name": "kai-core-desktop",
  "productName": "KAI Core Beta",
  "version": "0.7.5",
  "private": true,
  "description": "KAI Core Beta: a documented foundation for independent plugins",
  "license": "MIT",
  "author": "therexdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/therexdev/kai-core.git"
  },
  "workspaces": [
    "core"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=2 \"core/test-core/*.test.js\" \"examples/test/*.test.js\"",
    "test:compat": "npm run test:services",
    "dist": "npm run build:manifest && electron-builder --publish never",
    "plugin:pack": "node scripts/core/pack-plugin.js",
    "test:apps": "node scripts/foundation/apps-smoke.js",
    "build:manifest": "node scripts/foundation/build-manifest.js",
    "prepack": "npm run build:manifest",
    "test:services": "node --test --test-concurrency=2 core/test/wallet-session-secret.test.js core/test/wallet-credential-vault.test.js core/test/wallet-first-integration.test.js core/test/koin-credit-service.test.js core/test/credit-account.test.js core/test/model-manager.test.js core/test/gateway.test.js",
    "test:foundation-native": "node scripts/foundation/native-smoke.js",
    "test:alpha-migration": "node scripts/foundation/alpha-migration-smoke.js",
    "test:credit-reconnect": "node scripts/foundation/credit-reconnect-smoke.js",
    "test:dialogs": "node scripts/foundation/dialogs-smoke.js"
  },
  "devDependencies": {
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.62.1"
  },
  "main": "electron/core-main.js",
  "build": {
    "appId": "io.koinosai.core",
    "productName": "KAI Core Beta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "core/lib/account.js",
      "core/lib/alpha-model-migration.js",
      "core/lib/device-free-account.js",
      "core/lib/download.js",
      "core/lib/gateway.js",
      "core/lib/hardware.js",
      "core/lib/jail.js",
      "core/lib/keys.js",
      "core/lib/keystore.js",
      "core/lib/koin-network/chain.js",
      "core/lib/koin-network/credit-model-prices.json",
      "core/lib/koin-network/credit-service.json",
      "core/lib/koin-network/credits-abi.json",
      "core/lib/koin-network/funded-chat.js",
      "core/lib/koin-network/funded-protocol.js",
      "core/lib/koin-network/funding-cancel.js",
      "core/lib/koin-network/funding-observer.js",
      "core/lib/koin-network/grant-chat.js",
      "core/lib/koin-network/job-protocol.js",
      "core/lib/koin-network/journal-set.js",
      "core/lib/koin-network/mana-preflight.js",
      "core/lib/koin-network/payment-mode.js",
      "core/lib/koin-network/payment-network.js",
      "core/lib/koin-network/policy.js",
      "core/lib/koin-network/prepaid-usd-abi.json",
      "core/lib/koin-network/presence.js",
      "core/lib/koin-network/product.js",
      "core/lib/koin-network/provider-device-protocol.js",
      "core/lib/koin-network/provider-diagnostics.js",
      "core/lib/koin-network/purchase-mana.js",
      "core/lib/koin-network/purchase-market-estimate.js",
      "core/lib/koin-network/purchase-market.js",
      "core/lib/koin-network/purchase-provenance.js",
      "core/lib/koin-network/purchase-quote.js",
      "core/lib/koin-network/qualification-protocol.js",
      "core/lib/koin-network/qualification-result.js",
      "core/lib/koin-network/rewards-abi.json",
      "core/lib/koin-network/rpc-provider.js",
      "core/lib/koin-network/session-delegation.js",
      "core/lib/koin-network/shadow-worker.js",
      "core/lib/koin-network/status.js",
      "core/lib/koinos-rpc.js",
      "core/lib/koinos/chain.js",
      "core/lib/koinos/constants.js",
      "core/lib/koinos/eth.js",
      "core/lib/koinos/format.js",
      "core/lib/koinos/operation-lifetime.js",
      "core/lib/koinos/pob-abi.json",
      "core/lib/koinos/token-abi.json",
      "core/lib/koinos/wallet-history.js",
      "core/lib/koinos/wallet-nonce.js",
      "core/lib/legacy-kai-balance.js",
      "core/lib/local-chat-messages.js",
      "core/lib/model-manager.js",
      "core/lib/network-overview.js",
      "core/lib/plugins/download.js",
      "core/lib/plugins/first-party.json",
      "core/lib/plugins/manager.js",
      "core/lib/plugins/package-file-verifier.js",
      "core/lib/plugins/package-file.js",
      "core/lib/plugins/package-io.js",
      "core/lib/plugins/package.js",
      "core/lib/plugins/registry-format.js",
      "core/lib/plugins/registry.js",
      "core/lib/plugins/updates.js",
      "core/lib/protected-storage.js",
      "core/lib/public-http.js",
      "core/lib/release-channel.js",
      "core/lib/runtime-manager.js",
      "core/lib/runtime-provisioner.js",
      "core/lib/runtimes/llamacpp.js",
      "core/lib/runtimes/ollama.js",
      "core/lib/source-update.js",
      "core/lib/sqlite-path.js",
      "core/lib/store.js",
      "core/lib/wallet-credential-vault.js",
      "core/lib/wallet-credit-account.js",
      "core/lib/wallet.js",
      "core/lib/worker.js",
      "core/lib/zip.js",
      "core/models/catalog.json",
      "core/package.json",
      "core/server.js",
      "electron/alpha-migration.js",
      "electron/core-app-order.js",
      "electron/core-chat.js",
      "electron/core-dialogs-preload.js",
      "electron/core-dialogs.js",
      "electron/core-main.js",
      "electron/core-plugin-catalog.js",
      "electron/core-plugin-host.js",
      "electron/core-plugin-install-preload.js",
      "electron/core-plugin-install.js",
      "electron/core-plugin-preload.js",
      "electron/core-preload.js",
      "electron/core-renderer-dialogs.js",
      "electron/core-tray.js",
      "electron/core-wallet.js",
      "electron/credit-model-pricing.js",
      "electron/credit-models.js",
      "electron/credit-network-eligibility.js",
      "electron/credit-provider.js",
      "electron/credit-purchase-access.js",
      "electron/credit-purchase-journals.js",
      "electron/credit-purchase-progress.js",
      "electron/credit-purchase-quotes.js",
      "electron/credit-purchases.js",
      "electron/credit-runs.js",
      "electron/credit-service.js",
      "electron/foundation-api.js",
      "electron/foundation-network.js",
      "electron/foundation-plugin-services.js",
      "electron/foundation-profile.js",
      "electron/koin-chat-flow.js",
      "electron/koin-funding-approval.js",
      "electron/koin-funding-failure.js",
      "electron/koin-funding-recovery.js",
      "electron/koin-prepaid-chat.js",
      "electron/koin-provider-status.js",
      "electron/koin-purchase-cancel.js",
      "electron/koin-review.js",
      "electron/koin-session-client.js",
      "electron/koin-session-review.js",
      "electron/koin-test-access.js",
      "electron/koin-test-config.js",
      "electron/koin-test-ipc.js",
      "electron/koin-test-payments.js",
      "electron/provider-device.js",
      "electron/session-free-chat.js",
      "electron/wallet-session-secret.js",
      "electron/window-security.js",
      "package.json",
      "ui-core/reward-summary.js",
      "ui-core/**",
      "core/models/**",
      "core/runtimes/catalog.json",
      "build/icon.*",
      "build/foundation-files.json"
    ],
    "extraResources": [],
    "asarUnpack": [
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "executableName": "KAI Core"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "KAI-Core-Beta-Setup-${version}-${arch}.${ext}",
      "shortcutName": "KAI Core Beta",
      "uninstallDisplayName": "KAI Core Beta"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "KAI-Core-Beta-${version}-${os}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Koinos AI uses the microphone when you start voice input or enable Hey KAI listening.",
        "NSCameraUsageDescription": "Koinos AI uses the camera only while you explicitly enable Camera in KAI Eyes."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "kai-core",
      "desktop": {
        "entry": {
          "Name": "KAI Core Beta",
          "StartupWMClass": "kai-core"
        }
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "therexdev",
        "repo": "kai-core",
        "releaseType": "draft"
      }
    ],
    "artifactName": "KAI-Core-Beta-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "KAI-Core-Beta-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^1.7.2",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "koilib": "^9.4.0",
    "semver": "7.8.5",
    "builder-util-runtime": "9.7.0"
  },
  "kaiChannel": "core"
}
