{
  "name": "kai-core-desktop",
  "productName": "KAI Core",
  "version": "0.6.1",
  "private": true,
  "description": "KAI Core desktop: shared models and identity with isolated optional plugins",
  "license": "MIT",
  "author": "therexdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/therexdev/kai-core.git"
  },
  "workspaces": [
    "core"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=2 \"core/test-core/*.test.js\"",
    "test:compat": "node --test --test-concurrency=2 core/test/profile-backup.test.js core/test/wallet-session-secret.test.js core/test/wallet-credential-vault.test.js core/test/wallet-first-integration.test.js core/test/koin-credit-service.test.js core/test/credit-account.test.js core/test/model-manager.test.js core/test/gateway.test.js",
    "test:legacy": "node --test --test-concurrency=2 \"core/test/*.test.js\"",
    "test:native-profile": "node scripts/verify-shared-profile.js",
    "test:plugin-sandbox": "electron scripts/core/plugin-sandbox-probe.js",
    "dist": "electron-builder --publish never",
    "plugin:pack": "node scripts/core/pack-plugin.js",
    "test:desktop": "node scripts/core/desktop-smoke.js",
    "test:plugins": "electron scripts/core/plugins-smoke.js",
    "test:apps": "node scripts/core/apps-smoke.js"
  },
  "bin": {
    "koinos-code": "cli/koinos-code.js"
  },
  "devDependencies": {
    "@ricky0123/vad-web": "0.0.29",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.62.1"
  },
  "main": "electron/core-main.js",
  "build": {
    "appId": "io.koinosai.core",
    "productName": "KAI Core",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "core/**",
      "ui-core/**",
      "ui/**",
      "cli/**",
      "!core/test/**",
      "!core/test-core/**",
      "build/icon.*",
      "package.json",
      "!core/scheduler/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@ricky0123/vad-web/dist/bundle.min.js",
        "to": "live-senses/vad/bundle.min.js"
      },
      {
        "from": "node_modules/@ricky0123/vad-web/dist/vad.worklet.bundle.min.js",
        "to": "live-senses/vad/vad.worklet.bundle.min.js"
      },
      {
        "from": "node_modules/@ricky0123/vad-web/dist/silero_vad_v5.onnx",
        "to": "live-senses/vad/silero_vad_v5.onnx"
      },
      {
        "from": "node_modules/.cache/kai-live-senses/turn/smart-turn-v3.2-cpu.onnx",
        "to": "live-senses/turn/smart-turn-v3.2-cpu.onnx"
      },
      {
        "from": "docs/licenses/KAI-LIVE-SENSES.txt",
        "to": "live-senses/LICENSE.txt"
      }
    ],
    "asarUnpack": [
      "core/lib/jail.js",
      "build/icon.png",
      "build/icon.ico",
      "cli/**",
      "ui/agents.js",
      "node_modules/onnxruntime-node/**",
      "node_modules/kokoro-js/**",
      "node_modules/phonemizer/**",
      "node_modules/onnxruntime-web/**",
      "node_modules/sherpa-onnx*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "KAI-Core-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "KAI-Core-${version}-${os}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Koinos AI uses the microphone when you start voice input or enable Hey KAI listening.",
        "NSCameraUsageDescription": "Koinos AI uses the camera only while you explicitly enable Camera in KAI Eyes."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "kai-core",
      "desktop": {
        "entry": {
          "Name": "KAI Core",
          "StartupWMClass": "kai-core"
        }
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "therexdev",
        "repo": "kai-core",
        "releaseType": "draft"
      }
    ],
    "artifactName": "KAI-Core-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "KAI-Core-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^1.7.2",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "koilib": "^9.4.0",
    "cron-parser": "5.10.0",
    "quickjs-emscripten": "0.32.0",
    "@huggingface/transformers": "3.5.1",
    "imapflow": "^1.7.1",
    "kokoro-js": "1.2.1",
    "mailparser": "3.9.43",
    "nodemailer": "10.1.4",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "sherpa-onnx-node": "1.13.7"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "sharp": "0.35.5"
  },
  "kaiChannel": "core"
}
